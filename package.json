{
  "name": "convo-certo-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare-notices.mjs && react-router build && node scripts/exclude-local-editions.mjs",
    "dev": "react-router dev",
    "start": "npx serve build/client",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "repertoire:prepare": "uv run --with mido scripts/prepare_repertoire.py",
    "ensemble:prepare": "uv run scripts/prepare_ensemble_scores.py",
    "musicxml:from-midi": "uv run --with music21 scripts/convert_midi_to_musicxml.py",
    "instruments:prepare": "uv run scripts/prepare_instruments.py",
    "native:build": "node scripts/build-native.mjs",
    "native:test": "build/native/ConvoCerto.app/Contents/MacOS/ConvoCerto --smoke-test",
    "verify:release": "node scripts/verify-release.mjs",
    "native:unit": "node scripts/test-native-midi.mjs",
    "research:benchmark": "node scripts/benchmark-followers.mjs",
    "research:compare": "node scripts/benchmark-followers.mjs --matchmaker",
    "notices:prepare": "node scripts/prepare-notices.mjs",
    "native:package": "node scripts/package-native.mjs",
    "native:recovery": "node scripts/test-native-recovery.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mediapipe/tasks-vision": "0.10.32",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@react-router/node": "^7.12.0",
    "fflate": "^0.8.3",
    "isbot": "^5",
    "opensheetmusicdisplay": "^1.9.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.12.0",
    "sass": "^1.97.3",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@react-router/dev": "7.12.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.18"
  }
}
